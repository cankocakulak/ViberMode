{
  "name": "viber-mode",
  "version": "0.1.0",
  "description": "Vendor-agnostic AI agent development framework",
  "private": true,
  "type": "module",
  "exports": {
    "./packs/*": "./packs/*",
    "./adapters/*": "./adapters/*",
    "./scripts/*": "./scripts/*"
  },
  "files": [
    "packs",
    "adapters",
    "docs",
    "scripts"
  ],
  "scripts": {
    "install:codex": "bash adapters/codex/install/install-skills.sh",
    "install:claude": "bash adapters/claude/install/install-skills.sh",
    "change-release:gate": "node scripts/change-release-gate-check.mjs",
    "app:resolve": "node scripts/app-autopilot-resolve.mjs",
    "research:ingest": "node scripts/ingest-market-source.mjs",
    "research:public-scan": "node scripts/research-public-app-scan.mjs",
    "research:daily-brief": "node scripts/research-daily-brief.mjs",
    "research:competitor-teardown": "node scripts/mobile-competitor-teardown.mjs",
    "research:ledger": "node scripts/idea-research-ledger.mjs",
    "research:slack-sync": "node scripts/research-slack-sync.mjs",
    "workspace:topology": "node scripts/workspace-topology.mjs",
    "workspace:provision": "node scripts/workspace-bundle-provision.mjs",
    "factory:experience-gate": "node scripts/ios-factory-experience-gate.mjs",
    "export:idea-to-testflight": "node scripts/export-idea-to-testflight-visual.mjs",
    "export:idea-to-testflight:png": "node scripts/export-idea-to-testflight-png.mjs",
    "export:idea-to-testflight:all": "npm run export:idea-to-testflight && npm run export:idea-to-testflight:png",
    "revenuecat": "node scripts/revenuecat-api.mjs",
    "revenuecat:status": "node scripts/revenuecat-api.mjs status",
    "revenuecat:projects": "node scripts/revenuecat-api.mjs projects",
    "ios:inspect-ipa-config": "node scripts/ios-inspect-ipa-config.mjs",
    "store-downloads:notion": "node scripts/store-downloads-to-notion.mjs",
    "store-downloads:notion:manual": "node scripts/store-downloads-to-notion.mjs --backfill-weeks 4",
    "store-downloads:notion:android-backfill": "node scripts/store-downloads-to-notion.mjs --backfill-weeks 4 --skip-ios --allow-android-overwrite",
    "store-downloads:notion:overwrite": "node scripts/store-downloads-to-notion.mjs --backfill-weeks 4 --allow-overwrite",
    "slack:rox": "node scripts/slack-rox-bot.mjs",
    "slack:rox:probe": "node scripts/slack-rox-bot.mjs probe",
    "slack:rox:scan": "node scripts/slack-rox-bot.mjs scan",
    "slack:rox:events": "node scripts/slack-rox-event-bridge.mjs",
    "slack:rox:events:probe": "node scripts/slack-rox-event-bridge.mjs probe",
    "slack:rox:events:status": "node scripts/slack-rox-event-bridge.mjs agent-status",
    "slack:rox:events:install-agent": "node scripts/slack-rox-event-bridge.mjs install-agent",
    "slack:rox:events:uninstall-agent": "node scripts/slack-rox-event-bridge.mjs uninstall-agent",
    "slack:rox:context": "node scripts/slack-rox-context.mjs",
    "test:slack-rox-context": "node --test tests/slack-rox-context.test.mjs",
    "test:idea-research": "node --test tests/idea-research-ledger.test.mjs tests/research-slack-sync.test.mjs",
    "reviews:stores": "node scripts/store-review-ops.mjs",
    "reviews:stores:backlog": "node scripts/store-review-ops.mjs --include-backlog --max-results 200",
    "reviews:stores:reply": "node scripts/store-review-ops.mjs --reply",
    "reviews:stores:reply:backlog": "node scripts/store-review-ops.mjs --reply --include-backlog --max-results 200",
    "validate:references": "node scripts/validate-reference-map.mjs",
    "validate:task-phases": "node scripts/validate-task-phases.mjs",
    "validate": "npm run validate:references && npm run validate:task-phases",
    "growth:collect": "node scripts/weekly-app-growth.mjs",
    "growth:publish": "node scripts/weekly-app-growth.mjs --publish",
    "test:growth": "node --test tests/weekly-app-growth.test.mjs tests/weekly-app-meeting.test.mjs tests/weekly-app-completion.test.mjs tests/weekly-report-semantics.test.mjs tests/weekly-interpretation.test.mjs tests/weekly-funnel-presentation.test.mjs",
    "growth:weekly": "node scripts/weekly-app-growth-refresh.mjs --publish"
  },
  "keywords": [
    "ai",
    "agents",
    "cursor",
    "codex",
    "framework"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
